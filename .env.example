# ========================================
# InstaPost Configuration (Local)
# ========================================
# This file configures the local CLI for remote VM control.
# API credentials are stored on the VM only.

# ========================================
# VM Configuration (Remote Server)
# ========================================
# SSH host alias (from ~/.ssh/config) or user@hostname
VM_HOST=instapost-deploy

# Remote paths on the VM
VM_INSTAPOST_DIR=/home/ironsirens/instapost
VM_IMAGES_DIR=/mnt/s3/images
VM_PROCESSED_DIR=/mnt/s3/processed
