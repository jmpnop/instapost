# ========================================
# InstaPost Configuration (VM)
# ========================================
# This file is deployed to the VM for cron jobs.
# Copy to .env on the VM and fill in credentials.

# ========================================
# Static Hosting Configuration
# ========================================
# Base URL where images are served via Cloudflare tunnel
IMAGE_BASE_URL=https://instapost.celestialtech.io

# ========================================
# Facebook Graph API Configuration
# ========================================
# Create a Facebook App at: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# ========================================
# Instagram Configuration
# ========================================
# Get this from your Facebook Page Settings -> Instagram
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# ========================================
# Application Settings
# ========================================
# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/New_York

# ========================================
# Weekly Posting Schedule
# ========================================
# Format: "DAY:HOUR:MINUTE,DAY:HOUR:MINUTE,..."
# Days: 0=Monday, 1=Tuesday, ..., 6=Sunday
WEEKLY_SCHEDULE="0:07:00,2:11:00,4:17:00,5:09:00,6:18:00"

# ========================================
# AI Caption Generation (Optional)
# ========================================
# Prompt template for AI caption generation
# Use {image_path} placeholder for the image path
CAPTION_PROMPT="Describe this image for Instagram."
